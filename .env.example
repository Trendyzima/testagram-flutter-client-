# Public Testagram application endpoints only. Never put server keys or tokens here.
# Never place server keys, private tokens or provider credentials in the Flutter build environment.
TESTAGRAM_API_URL=https://api.testagram.site
TESTAGRAM_SITE_URL=https://testagram.site
TESTAGRAM_TERMS_VERSION=2026-11-11
TESTAGRAM_PRIVACY_VERSION=2026-11-11

# Registration UI remains disabled until the native identity workflow passes production acceptance.
TESTAGRAM_IDENTITY_REGISTRATION_UI_ENABLED=false
TESTAGRAM_TV_ENABLED=false
TESTAGRAM_TV_PLAYBACK_HOSTS=media.testagram.site
